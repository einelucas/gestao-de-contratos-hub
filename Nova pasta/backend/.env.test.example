# Banco exclusivo de testes. O nome deve terminar com _test.
APP_ENV=test
DATABASE_URL=postgresql://contratos:contratos@localhost:5433/gestao_contratos_test
MIGRATION_DATABASE_URL=postgresql://contratos:contratos@localhost:5433/gestao_contratos_test
ALLOW_TEST_DB_MIGRATIONS=true
CORS_ORIGINS=http://localhost:3000
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=
DEV_AUTH_ENABLED=true
LOG_LEVEL=INFO
NOTIFICATION_PROVIDER=log

# Os testes usam o modo keycloak + bypass de desenvolvimento (não herdar o modo do .env local).
AUTH_PROVIDER=keycloak
