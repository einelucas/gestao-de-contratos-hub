# Copie para .env e cole as duas URLs fornecidas pelo Neon.
APP_ENV=development

# Neon pooled connection: use a URL cujo host normalmente contém "-pooler".
# Ex.: postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon direct connection: recomendada para Alembic/migrations (host sem "-pooler").
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Confirmação explícita para migrations no ambiente development.
ALLOW_TEST_DB_MIGRATIONS=true
CORS_ORIGINS=http://localhost:3000

# Keycloak / OIDC — pode ficar vazio no desenvolvimento local.
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=
KEYCLOAK_ALLOWED_ALGORITHMS=RS256
JWKS_CACHE_TTL_SECONDS=3600

# Login local para VS Code/desenvolvimento.
DEV_AUTH_ENABLED=true
DEV_AUTH_USER_EMAIL=dev@example.com
LOG_LEVEL=INFO

# Alertas de vencimento por e-mail (ver docs/alertas-email.md):
#   log     = só registra (simulação)
#   mailpit = SMTP local de homologação, captura sem entregar (nunca em produção)
#   graph   = Microsoft Graph, envio corporativo real (único provider de produção)
NOTIFICATION_PROVIDER=log

# Mailpit (somente com NOTIFICATION_PROVIDER=mailpit; sem autenticação).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_SENDER_EMAIL=gestao.contratos@hub.local
# Dev/homologação: redireciona TODOS os alertas para esta caixa (proibido em produção).
NOTIFICATION_REDIRECT_TO=
# URL pública do frontend para o botão "Abrir no Hub" do e-mail (opcional).
APP_PUBLIC_URL=http://localhost:3000

# Microsoft Graph (obrigatórias só com NOTIFICATION_PROVIDER=graph). Nunca versione o segredo.
# Também aceitos: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET e GRAPH_SENDER_EMAIL.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=contratos@empresa.com.br
GRAPH_SAVE_TO_SENT_ITEMS=true
GRAPH_TIMEOUT_SECONDS=20

# Autenticação: "keycloak" (SSO corporativo, oficial) ou "homologation" (login temporário).
# Ver docs/login-homologacao.md. Em homologation, Bearer/Keycloak e DEV_AUTH ficam desligados.
AUTH_PROVIDER=keycloak
# Só com AUTH_PROVIDER=homologation. Hashes Argon2 gerados por: python scripts/hash_password.py
# (NUNCA a senha em texto; nunca versione estes valores).
HOMOLOGATION_VIEWER_USERNAME=
HOMOLOGATION_VIEWER_PASSWORD_HASH=
HOMOLOGATION_ADMIN_USERNAME=
HOMOLOGATION_ADMIN_PASSWORD_HASH=
AUTH_SESSION_HOURS=8
# true exige HTTPS (obrigatório em produção); false só em http://localhost.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# true quando a API está atrás do proxy do Nuxt/plataforma (limite de tentativas por IP real).
TRUST_PROXY_HEADERS=false
