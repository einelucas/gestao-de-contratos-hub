# O navegador fala com o próprio Nuxt (/api/v1), que faz proxy para o FastAPI em NUXT_API_PROXY_TARGET.
# Assim o cookie de sessão é de mesma origem. Só aponte NUXT_PUBLIC_API_BASE_URL direto para a API se souber o porquê.
NUXT_PUBLIC_API_BASE_URL=/api/v1
NUXT_API_PROXY_TARGET=http://localhost:8000
# FastAPI. O cliente acrescenta /api/v1 se ele não estiver presente.

# OIDC/Keycloak. Deixe vazio no desenvolvimento com tokens dev.
NUXT_PUBLIC_OIDC_ISSUER=
NUXT_PUBLIC_OIDC_CLIENT_ID=
NUXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
NUXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# Autenticação local: exige DEV_AUTH_ENABLED=true no backend.
NUXT_PUBLIC_DEV_AUTH_ENABLED=true
